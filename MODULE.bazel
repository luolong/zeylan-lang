"Bazel dependencies, see https://registry.bazel.build"

module(
    name = "bourbon",
    version = "0.0.1",
)

bazel_dep(name = "rules_graalvm", version = "0.11.1")
bazel_dep(name = "rules_java", version = "9.7.0")
bazel_dep(name = "rules_jvm_external", version = "6.10")
bazel_dep(name = "contrib_rules_jvm", version = "0.34.0")

# Pin rules_go and rules_android to compatible versions. They are pulled in transitively
# by rules_jvm_external and contrib_rules_jvm, but their default transitive versions
# use deprecated APIs (like CcInfo) incompatible with modern Bazel.
bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "rules_android", version = "0.7.3")
bazel_dep(name = "rules_shell", version = "0.6.1")

# Setup GraalVM Toolchain (Java 25 Community Edition)
gvm = use_extension("@rules_graalvm//:extensions.bzl", "graalvm")
gvm.graalvm(
    name = "graalvm",
    distribution = "community",
    java_version = "25",
    version = "25.0.0",
)
use_repo(gvm, "graalvm")

# Register JVM and SDK toolchains
register_toolchains("@graalvm//:jvm", "@graalvm//:sdk")

git_override(
    module_name = "rules_graalvm",
    commit = "40bbecd298c2357d3796eff2988793deffd2a782",
    remote = "https://github.com/sgammon/rules_graalvm.git",
)

# Setup Maven Dependencies
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        "org.jspecify:jspecify:1.0.0",
        "org.jline:jansi:4.3.1",
        "org.jline:jline-terminal:4.3.1",
        "org.jline:jline-terminal-jni:4.3.1",
        "org.jline:jline-reader:4.3.1",
        "com.uber.nullaway:nullaway:0.13.8",
        "info.picocli:picocli:4.7.6",
        "info.picocli:picocli-codegen:4.7.6",
        "org.junit.jupiter:junit-jupiter-api",
        "org.junit.jupiter:junit-jupiter-engine",
        "org.junit.jupiter:junit-jupiter-params",
        "org.junit.platform:junit-platform-launcher",
        "org.junit.platform:junit-platform-reporting",
    ],
    boms = [
        "org.junit:junit-bom:6.1.3",
    ],
    fetch_javadoc = True,
    fetch_sources = True,
    lock_file = "//:maven_install.json",
)
use_repo(maven, "maven")
