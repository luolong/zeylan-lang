genrule(
    name = "site",
    srcs = glob([
        "antora.yml",
        "modules/**/*",
        "supplemental-ui/**/*",
    ]) + [
        "//:antora-playbook.yml",
        "//:package.json",
        "//:package-lock.json",
    ],
    outs = ["site_archive.tar.gz"],
    cmd = """
    # Dereference package files so npm and git can work with them as writable/regular files
    cp -L $(location //:package.json) package.json.tmp && rm -f package.json && mv package.json.tmp package.json
    cp -L $(location //:package-lock.json) package-lock.json.tmp && rm -f package-lock.json && mv package-lock.json.tmp package-lock.json
    cp -L $(location //:antora-playbook.yml) antora-playbook.yml.tmp && rm -f antora-playbook.yml && mv antora-playbook.yml.tmp antora-playbook.yml

    # Initialize a temporary git repository so Antora (which requires Git) can run inside the sandbox
    git init
    git config user.email "build@zeylan.local"
    git config user.name "Bazel Builder"
    
    # Stage the files provided as inputs to the sandbox
    git add antora-playbook.yml docs package.json package-lock.json
    git commit -m "Mock commit for Antora"

    # Install dependencies inside the sandbox node_modules using npm ci (faster, doesn't write back)
    npm ci --no-audit --no-fund

    # Build the Antora site inside the sandbox
    npx antora --fetch antora-playbook.yml

    # Package the generated site and copy it to Bazel's output path
    tar -czf $@ -C build/site .
    """,
    tags = ["requires-network"],
    visibility = ["//visibility:public"],
)
